<?xml version="1.0" encoding="utf-8" ?>
<!-- Copyright (c) ZeroC, Inc. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Import Tasks -->
  <UsingTask
    TaskName="IceRpc.Slice.Tools.SlicecTask"
    TaskFactory="$(_IceRpcSliceToolsTaskFactory)"
    AssemblyFile="$(_IceRpcSliceToolsTaskAssembliesPath)IceRpc.Slice.Tools.dll"
    Runtime="NET"
  />
  <!--
    Build-order-only references: the consuming project just needs these to be built so the generator scripts and the
    slicec compiler exist on disk before we invoke them. We don't want the referenced projects' assemblies or
    CopyToOutputDirectory items (e.g. the slicec-*-generator scripts, *.runtimeconfig.json) to flow into the
    consumer's bin. The metadata below switches each reference to "build-only" mode: ReferenceOutputAssembly=false
    skips the assembly reference and Private=false suppresses Copy Local, including the GetCopyToOutputDirectoryItems
    call on the referenced project.
  -->
  <ItemGroup Condition="'$(_IceRpcSliceToolsSourceBuild)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)IceRpc.Slice.Tools.csproj"
                      ReferenceOutputAssembly="false" Private="false" Targets="Build" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../ZeroC.Slice.Generator/ZeroC.Slice.Generator.csproj"
                      ReferenceOutputAssembly="false" Private="false" Targets="Build" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../IceRpc.Slice.Generator/IceRpc.Slice.Generator.csproj"
                      ReferenceOutputAssembly="false" Private="false" Targets="Build" />
  </ItemGroup>
  <ItemGroup>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)SliceFile.ItemDefinition.xaml" />
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)SliceFile.ProjectProperties.xaml">
      <Context>Project</Context>
    </PropertyPageSchema>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)SliceFile.FileProperties.xaml">
      <Context>File;BrowseObject</Context>
    </PropertyPageSchema>
    <AvailableItemName Include="SliceFile" />
  </ItemGroup>

  <!-- This capability is used to apply the SliceFile property page designer -->
  <ItemGroup>
    <ProjectCapability Include="SliceFile" />
  </ItemGroup>

  <ItemGroup Condition="'$(SetLinkMetadataAutomatically)' != 'false'">
    <SliceFile Update="@(SliceFile)">
      <LinkBase Condition="'%(LinkBase)' != ''">$([MSBuild]::EnsureTrailingSlash(%(LinkBase)))</LinkBase>
      <Link
        Condition="'%(Link)' == '' And '%(DefiningProjectExtension)' != '.projitems' And !$([MSBuild]::ValueOrDefault('%(FullPath)', '').StartsWith($([MSBuild]::EnsureTrailingSlash($(MSBuildProjectDirectory)))))"
      >%(LinkBase)%(RecursiveDir)%(FileName)%(Extension)</Link>
    </SliceFile>
  </ItemGroup>

  <!--
    The SDK includes the *.slice files as "None" items. We remove them because the .props already includes them as
    "SliceFile" items.
  -->
  <ItemGroup Condition="'$(EnableDefaultItems)' == 'true'">
    <None Remove="**/*.slice" />
  </ItemGroup>

  <!--
    Like the .NET SDK does for duplicate Compile items (NETSDK1022), reject a file listed more than once, typically an
    explicit Include of a file that is already a default item. Design-time builds continue on errors and use the
    deduplicated items, as the SDK does, so that the project still gets IntelliSense while the error is reported.
    Unlike the SDK, which compares item specs, this compares full paths: "./a.slice" or "sub/b.slice" names the same
    file as the default item "a.slice" or "sub\b.slice".
  -->
  <Target Name="_CheckForDuplicateSliceFiles"
          Condition="'$(EnableDefaultItems)' == 'true' And '$(EnableDefaultSliceFileItems)' == 'true'">
    <ItemGroup>
      <_SliceFileFullPath Include="@(SliceFile->'%(FullPath)')" />
      <_DuplicateSliceFile Include="%(_SliceFileFullPath.Identity)"
                           Condition="'@(_SliceFileFullPath->Count())' &gt; 1" />
    </ItemGroup>

    <Error
      Text="Duplicate 'SliceFile' items were included. IceRpc.Slice.Tools includes the '.slice' files in your project directory as 'SliceFile' items by default. Remove these items from your project file, use 'Update' instead of 'Include' to set their metadata, or set the 'EnableDefaultSliceFileItems' property to 'false' if you want to include them explicitly in your project file. The duplicate items were: @(_DuplicateSliceFile->'%(Identity)', '; ')"
      Condition="'@(_DuplicateSliceFile)' != ''"
      ContinueOnError="$(ContinueOnError)" />

    <ItemGroup Condition="'$(DesignTimeBuild)' == 'true' And '@(_DuplicateSliceFile)' != ''">
      <_DeduplicatedSliceFile Include="@(_SliceFileFullPath->Distinct())" />
      <SliceFile Remove="@(SliceFile)" />
      <SliceFile Include="@(_DeduplicatedSliceFile)" />
    </ItemGroup>
  </Target>

  <!--
    Computes the _SliceFile items: the Slice files to compile, each with the code generators to run on it and the
    paths of the files these generators produce.
  -->
  <Target Name="_ComputeSliceFiles" DependsOnTargets="_CheckForDuplicateSliceFiles" Condition="@(SliceFile) != ''">
    <ItemGroup>
      <_SliceFile Include="@(SliceFile)" />
      <_SliceFile>
        <Generators>%(_SliceFile.Generators);$(_ZeroCSliceGeneratorPath)slicec-csharp-generator$(_SliceGeneratorScriptExtension)</Generators>
        <GeneratedPath>%(_SliceFile.GeneratedPath);$([MSBuild]::NormalizePath('%(OutputDir)/%(FileName).cs'))</GeneratedPath>
      </_SliceFile>
      <_SliceFile Condition="'%(IceRpc)' == 'true'">
        <Generators>%(_SliceFile.Generators);$(_IceRpcSliceGeneratorPath)slicec-icerpc-csharp-generator$(_SliceGeneratorScriptExtension)</Generators>
        <GeneratedPath>%(_SliceFile.GeneratedPath);$([MSBuild]::NormalizePath('%(OutputDir)/%(FileName).IceRpc.cs'))</GeneratedPath>
      </_SliceFile>
      <!-- The xxx.BuildTelemetry.txt is generated when both IceRpcBuildTelemetry and IceRpcBuildTelemetryDebug are true -->
      <_SliceFile Condition="'$(IceRpcBuildTelemetry)' == 'true' And '$(IceRpcBuildTelemetryDebug)' == 'true'">
        <TelemetryPath>$([MSBuild]::NormalizePath('%(OutputDir)/%(FileName).BuildTelemetry.txt'))</TelemetryPath>
      </_SliceFile>
    </ItemGroup>
  </Target>

  <!--
    Delete generated files recorded in the previous build's manifest that the current build no longer produces.
    Without this, a removed/renamed .slice file (or a SliceFile whose OutputDir or IceRpc metadata changed) leaves
    orphan .cs files behind that the SDK's default Compile glob keeps picking up.

    Runs even when SliceFile is empty: the outputs of a previous build still need pruning.
  -->
  <Target Name="_SlicecPruneStaleOutputs"
          BeforeTargets="Slicec;SlicecClean"
          DependsOnTargets="_ComputeSliceFiles"
          Condition="Exists('$(IntermediateOutputPath)slicec.outputs.txt')">
    <ReadLinesFromFile File="$(IntermediateOutputPath)slicec.outputs.txt">
      <Output TaskParameter="Lines" ItemName="_PreviousSlicecOutput" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_CurrentSlicecOutput Include="%(_SliceFile.GeneratedPath)" />
      <_CurrentSlicecOutput Include="%(_SliceFile.TelemetryPath)" Condition="'%(_SliceFile.TelemetryPath)' != ''" />
      <_StaleSlicecOutput Include="@(_PreviousSlicecOutput)" Exclude="@(_CurrentSlicecOutput)" />
      <!-- Remove before deleting, or csc fails with CS2001 on the missing files. -->
      <Compile Remove="@(_StaleSlicecOutput)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
    </ItemGroup>
    <Delete Files="@(_StaleSlicecOutput)" />
    <!-- With no SliceFile left, _SlicecWriteOutputManifest doesn't run to replace the manifest. -->
    <Delete Files="$(IntermediateOutputPath)slicec.outputs.txt" Condition="@(SliceFile) == ''" />
  </Target>

  <!--
    Adds the build-telemetry generator to the _SliceFile items of a real build. BuildingProject is true only in a real
    build, so the design-time builds of an IDE don't send reports. The check is not in _ComputeSliceFiles because
    MSBuild runs a target at most once per build: a Rebuild runs _ComputeSliceFiles during Clean, before
    BuildingProject is set, and reuses its items for the build that follows.
  -->
  <Target Name="_AddSliceBuildTelemetryGenerator"
          DependsOnTargets="_ComputeSliceFiles"
          Condition="@(SliceFile) != '' And '$(IceRpcBuildTelemetry)' == 'true' And '$(BuildingProject)' == 'true'">
    <PropertyGroup>
      <_BuildTelemetryOptions>,slicec_version=$(SlicecVersion),toolchain=dotnet:$(NETCoreSdkVersion)</_BuildTelemetryOptions>
      <_BuildTelemetryOptions Condition="'$(IceRpcBuildTelemetryDryRun)' == 'true'">,dry_run$(_BuildTelemetryOptions)</_BuildTelemetryOptions>
      <_BuildTelemetryOptions Condition="'$(IceRpcBuildTelemetryDebug)' == 'true'">,debug$(_BuildTelemetryOptions)</_BuildTelemetryOptions>
      <_BuildTelemetryOptions Condition="'$(CI)' == 'true'">,ci$(_BuildTelemetryOptions)</_BuildTelemetryOptions>
    </PropertyGroup>
    <ItemGroup>
      <_SliceFile Condition="'%(IceRpc)' == 'true'">
        <BuildTelemetryGenerators>,generator=slicec-icerpc-csharp-generator:$(IceRpcSliceToolsVersion)</BuildTelemetryGenerators>
      </_SliceFile>
      <_SliceFile>
        <Generators>%(_SliceFile.Generators);$(_IceRpcSliceBuildTelemetryPath)slicec-build-telemetry$(_SliceGeneratorScriptExtension)$(_BuildTelemetryOptions),generator=slicec-csharp-generator:$(IceRpcSliceToolsVersion)%(_SliceFile.BuildTelemetryGenerators),generator=slicec-build-telemetry:$(IceRpcSliceToolsVersion)</Generators>
      </_SliceFile>
    </ItemGroup>
  </Target>

  <Target Name="Slicec"
          BeforeTargets="CoreCompile"
          DependsOnTargets="_ComputeSliceFiles;_AddSliceBuildTelemetryGenerator"
          Condition="@(SliceFile) != ''">
    <MakeDir Directories="%(_SliceFile.OutputDir)" />

    <SlicecTask
      WorkingDirectory="$(MSBuildProjectDirectory)"
      OutputDir="%(_SliceFile.OutputDir)"
      References="@(SliceDirectory->'%(FullPath)')"
      ToolsPath="$(_SliceCPath)"
      Generators="%(_SliceFile.Generators)"
      AdditionalOptions="%(_SliceFile.AdditionalOptions)"
      Sources="@(_SliceFile)"
    />

    <!--
      Include all C# generated source items that have not been already included. We delay this until we are
      running the Slicec target so that default includes are already processed.

      The Exclude is required to avoid including generated files twice for projects that have EnableDefaultItems,
      when the generated files already exists and match the default includes patterns, or for projects that
      manually included the generated files as Compile items.
    -->
    <ItemGroup>
      <Compile
        Include="%(_SliceFile.GeneratedPath)"
        Exclude="@(Compile->'%(FullPath)');@(Compile->'%(Identity)')"
        RemoveMetadata="OutputDir;AdditionalOptions;GeneratedPath;Generators;PackagePath;Pack"
      />
    </ItemGroup>
  </Target>

  <!-- Record this build's outputs so the next build can prune anything we no longer produce. -->
  <Target Name="_SlicecWriteOutputManifest"
          AfterTargets="Slicec"
          Condition="@(SliceFile) != ''">
    <ItemGroup>
      <_AllSlicecOutput Include="%(_SliceFile.GeneratedPath)" />
      <_AllSlicecOutput Include="%(_SliceFile.TelemetryPath)" Condition="'%(_SliceFile.TelemetryPath)' != ''" />
    </ItemGroup>
    <WriteLinesToFile
      File="$(IntermediateOutputPath)slicec.outputs.txt"
      Lines="@(_AllSlicecOutput)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="SlicecClean" BeforeTargets="Clean" DependsOnTargets="_ComputeSliceFiles">
    <Delete Files="%(_SliceFile.GeneratedPath)" />
    <Delete Files="%(_SliceFile.TelemetryPath)" Condition="'%(_SliceFile.TelemetryPath)' != ''" />
    <Delete Files="$(IntermediateOutputPath)slicec.outputs.txt" />
  </Target>

  <!-- Package SliceFile items -->
  <Target Name="PackSliceFileItems" BeforeTargets="GenerateNuspec">
    <CreateItem
      Include="@(SliceFile)"
      Condition="'%(SliceFile.Pack)' == 'true'"
      AdditionalMetadata="PackagePath=%(SliceFile.PackagePath)"
    >
      <Output TaskParameter="Include" ItemName="_PackageFiles" />
    </CreateItem>
  </Target>
</Project>
