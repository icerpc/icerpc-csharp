<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    SliceDirectory is the former name of SliceReference. Earlier versions of IceRpc.Slice.Tools read only
    SliceDirectory, and a project can use one of these versions with this package.
  -->
  <ItemGroup>
    <SliceDirectory Include="$(MSBuildThisFileDirectory)../slice" />
  </ItemGroup>
</Project>
