module IceRpc::Slice::Generator::Tests

[cs::identifier("REnamedInterface")]
interface OriginalInterface {
    [cs::identifier("REnamedOp")]
    op([cs::identifier("renamedParam")] myParam: int32) -> (
        [cs::identifier("renamedReturnOne")] myReturnOne: int32
        [cs::identifier("renamedReturnTwo")] myReturnTwo: int32
    )

    subscribe(user: string, [cs::identifier("@event")] event: string) -> (
        subscriber: string
        [cs::identifier("@return")] eventName: string
    )
}
