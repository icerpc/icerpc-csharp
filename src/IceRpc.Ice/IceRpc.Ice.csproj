<?xml version="1.0" encoding="utf-8" ?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>IceRPC + Ice integration for C#.</Description>
    <AssemblyTitle>$(Description)</AssemblyTitle>
    <PackageTags>icerpc;ice;binary;serialization;format</PackageTags>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <SliceCompile
      Include="../../slice/Ice/Identity.ice;../../slice/IceRpc/Ice/Object.ice"
      OutputDir="$(MSBuildProjectDirectory)/generated"
    />

    <SliceCompile
      Include="../../slice/IceRpc/Ice/Internal/*.ice"
      OutputDir="$(MSBuildProjectDirectory)/generated/Internal"
    />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../IceRpc/IceRpc.csproj" ExactVersion="true" />
    <ProjectReference Include="../IceRpc.ServiceGenerator/IceRpc.ServiceGenerator.csproj"
                      Condition="'$(DocFxBuild)' != 'true'"
                      ExactVersion="true"
                      PrivateAssets="compile;runtime"
                      OutputItemType="Analyzer" />
    <!-- No PrivateAssets="all": the IceRpc.Ice package depends on the Slice tools package to enforce the version range
         it supports. A project that references IceRpc.Ice gets no asset from this dependency, since the Slice tools
         package has only build assets, which are private by default. -->
    <PackageReference Include="ZeroC.Ice.Slice.Tools" />

    <PackageReference Include="StyleCop.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <!-- NuGet package contents-->
  <ItemGroup>
    <Content Include="../../LICENSE" Pack="true" PackagePath="/" />
    <Content Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../build/icerpc-icon.png" Pack="true" PackagePath="/" />
    <Content Include="IceRpc.Ice.props" Pack="true" PackagePath="buildTransitive" />
    <Content
      Include="../../slice/Ice/Identity.ice;../../slice/Ice/Locator.ice;../../slice/Ice/LocatorRegistry.ice;../../slice/Ice/Process.ice"
      Pack="true"
      PackagePath="slice/Ice"
    />
  </ItemGroup>
</Project>
